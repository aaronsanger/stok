# Set DB_ENGINE=vertica on the office workstation or Django server.
# Set DB_ENGINE=sqlite_mock when testing offline without Vertica access.
DB_ENGINE=sqlite_mock

VERTICA_HOST=10.x.x.x
VERTICA_PORT=5433
VERTICA_DB=your_db_name
VERTICA_USER=your_db_user
VERTICA_PASSWORD=CHANGE_ME_ON_WORKSTATION
VERTICA_SSL=false
VERTICA_TIMEOUT=30

# Schema, table, and filter placeholders injected into sql/StockChecking.sql at runtime (kept out of git!)
VERTICA_SCHEMA=your_schema
VERTICA_TABLE_STOK=your_stok_table
VERTICA_TABLE_OMS=your_oms_table
VERTICA_DIVISI=your_division_code
VERTICA_FILTER_YEAR=2026
VERTICA_FILTER_MONTH=11
VERTICA_EXCLUDED_GROUPS=EXCLUDE_GRP_1,EXCLUDE_GRP_2
